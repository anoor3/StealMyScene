# Required for authenticated admin sessions. Use at least 32 random characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# S3 or Cloudflare R2 ingestion storage.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Local development can use the filesystem-backed ingestion adapter.
STORAGE_DRIVER=local

# WhisperX executable and model used by the ingestion worker.
WHISPERX_COMMAND=whisperx
WHISPERX_MODEL=small
TRANSCRIPTION_DRIVER=whisperx

# Production deployment hook called after a scene/manifest publication.
REBUILD_HOOK_URL=

# Temporary hosted links. Configure a scheduled POST to the cleanup endpoint.
SHARE_CLEANUP_SECRET=
SHARE_BLOCKED_TERMS=

# Scheduled anonymous analytics aggregation. Use at least 32 random characters.
ANALYTICS_AGGREGATION_SECRET=

# Shared atomic rate-limit service for every production API instance.
RATE_LIMIT_SERVICE_URL=
RATE_LIMIT_SERVICE_TOKEN=

# Required on the real HTTPS deployment. Never enable HSTS on local HTTP.
ENABLE_HSTS=false
