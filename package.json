{
  "name": "steal-my-scene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run prepare:ffmpeg && npm run sync:catalog",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e-studio.mjs",
    "test:e2e:admin": "node scripts/e2e-admin.mjs",
    "test:e2e:create": "node scripts/e2e-local-create.mjs",
    "test:e2e:webkit": "node scripts/e2e-webkit.mjs",
    "test:load:smoke": "node scripts/load-smoke.mjs",
    "verify:catalog": "node scripts/verify-public-domain-catalog.mjs",
    "generate:scenes": "node scripts/fetch-public-domain-sources.mjs && node scripts/generate-public-domain-scenes.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "postinstall": "npm run prepare:ffmpeg",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:catalog && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "latest",
    "@ffmpeg/util": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^29.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "latest",
    "vitest": "latest"
  }
}
